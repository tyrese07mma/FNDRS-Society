# Public client configuration (never use the service-role key here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Optional services stay off until their hosted integration is verified.
EXPO_PUBLIC_AI_ENABLED=false
EXPO_PUBLIC_BILLING_ENABLED=false
# Required by build:release; public HTTPS pages reviewed by the operator.
EXPO_PUBLIC_WEB_ORIGIN=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_IMPRINT_URL=
EXPO_PUBLIC_GUIDELINES_URL=
# Server secrets belong in Supabase Edge Function secrets, not this file.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: provided by Supabase
# ANTHROPIC_API_KEY=
# AI_MODEL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# APP_URL=
# PRICE_PRO_MONTH= / PRICE_PRO_YEAR=
# PRICE_BUSINESS_MONTH= / PRICE_BUSINESS_YEAR=
# PRICE_INVESTOR_MONTH= / PRICE_INVESTOR_YEAR=
